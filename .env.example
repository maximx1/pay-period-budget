# For local development: copy to .env to override. Every value here is the default.
# For Docker on a server use .env.docker.example instead.
API_PORT=8787
DATABASE_URL=file:./data/app.db
# Comma-separated browser origins allowed to call the API with cookies.
APP_ORIGINS=http://localhost:5173
SESSION_TTL_DAYS=30
# Minutes without activity before the web app signs out and the Android app locks. 0 = never.
IDLE_TIMEOUT_MINUTES=10
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Session cookie is HTTPS-only. Defaults to true in production, false otherwise.
# COOKIE_SECURE=true
# New accounts can be created. Set to false on a server once yours exists.
ALLOW_REGISTRATION=true
# API tokens work, and with them an AI assistant (the MCP server). Set to false to refuse
# them all; the tokens are kept and work again when it is set back.
ALLOW_API_TOKENS=true
# Optional: an OpenAI-compatible model of your own that reads screenshots for imports, in
# place of the built-in reader. SCAN_MODEL_ENABLED=false turns it off and keeps the rest.
# SCAN_MODEL_URL=http://localhost:11434/v1
# SCAN_MODEL=qwen2.5:7b
# SCAN_MODEL_KEY=
# SCAN_MODEL_ENABLED=true
# SCAN_MODEL_IMAGES=false
# SCAN_MODEL_TIMEOUT_SECONDS=90
