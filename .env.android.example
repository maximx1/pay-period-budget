# For the Android app: copy to .env.android. Read by `npm run build:android`.
#
# Where the app finds the API. The server must list the app's own origin,
# https://localhost, in APP_ORIGINS or it refuses every request from the phone.
VITE_API_BASE_URL=https://budget.example.com

# While developing, a debug build can use the API on this machine instead:
#   emulator:           VITE_API_BASE_URL=http://10.0.2.2:8787
#   phone on USB:       VITE_API_BASE_URL=http://127.0.0.1:8787   (after `adb reverse tcp:8787 tcp:8787`)
# A release build only ever talks HTTPS.
