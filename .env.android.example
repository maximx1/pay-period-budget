# Optional build settings for the Android app: copy to .env.android. Read by
# `npm run build:android`.
#
# Normally leave this file out. The app then asks for the server's address the first time
# it is opened ("Connect to your server"), and remembers it.
#
# The server must list the app's own origin, https://localhost, in APP_ORIGINS, or it
# refuses every request from the phone. The Docker setup does that by default.

# An address for the app to start with instead of asking. Mostly for development:
#   VITE_API_BASE_URL=http://127.0.0.1:8787    (after `adb reverse tcp:8787 tcp:8787`)
#   VITE_API_BASE_URL=http://10.0.2.2:8787     (emulator only, no adb reverse needed)
# Plain http works only to those development addresses, and only in a debug build.
# VITE_API_BASE_URL=https://budget.example.com
