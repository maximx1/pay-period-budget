# Settings for running with Docker Compose. Copy to .env next to compose.yaml.

# The address you will open the app at, exactly as it appears in the browser's address bar
# (no trailing slash). Required: requests that come from any other address are refused.
APP_URL=https://budget.example.com

# Set to false once your own account exists, so nobody else can create one.
ALLOW_REGISTRATION=true

# --- Only needed for "docker compose --profile caddy" ---
# The domain Caddy should serve and get a certificate for (the host part of APP_URL).
# APP_DOMAIN=budget.example.com

# --- Rarely changed ---
# Other origins allowed to use the API, comma-separated. The default, https://localhost, is
# the Android app (its pages are served from that address inside the phone). Set it to
# nothing to allow only APP_URL.
# APP_ALSO_ALLOW=https://localhost
# Where the app's port is published on this machine. 127.0.0.1 means only a reverse proxy
# on this machine can reach it; 0.0.0.0 exposes it to the network.
# APP_BIND=127.0.0.1
# APP_PORT=8787
# true when a reverse proxy sits in front (it passes the visitor's address along).
# TRUST_PROXY=true
# The session cookie is HTTPS-only. Set to false only to try the app over plain http.
# COOKIE_SECURE=true
# SESSION_TTL_DAYS=30
# Minutes without activity before the web app signs out and the Android app locks. 0 = never.
# IDLE_TIMEOUT_MINUTES=10
